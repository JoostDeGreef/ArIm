{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build debug mode (makefile)",
            "type": "shell",
            "command": "make",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Build release mode (makefile)",
            "type": "shell",
            "command": "make",
            "args": ["release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
