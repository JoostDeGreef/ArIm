{
    "version": "0.2.0",
    "setupCommands": [
        {
            "description": "Enable GDB pretty-printing",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        }
    ],
    "configurations": [
        {
            "name": "Debug tokenizer_ut",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/tokenizer_UT",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build debug mode (makefile)"
        },
        {
            "name": "Debug tokenizer_ut (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/tokenizer_UT",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build debug mode (makefile)"
        },
        {
            "name": "Debug db_ut (LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/db_UT",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build debug mode (makefile)"
        }
    ]
}